;; Collections, strings, hashes, sets, numbers, IO, errors, JSON.
(require "std/set" all:)
(require "std/hash" all:)
(define (ok name pred)
  (display (format "@@~a=~a" name (if pred 1 0))) (newline))
(ok "list" (equal? (map (lambda (x) (+ x 1)) (filter (lambda (x) (> x 1)) (list 1 2 3))) (list 3 4)))
(ok "string" (and (equal? (string-append "a" "b") "ab")
                  (equal? (substring "abcd" 1 3) "bc")
                  (= (string-length "abcd") 4)))
(define h (hash "a" 1))
(hash-set! h "b" 2)
(ok "hash" (and (= (hash-ref h "a") 1) (= (hash-table-ref h "b") 2) (= (hash-length h) 2)))
(define s (set 1))
(define t (set-add s 2))
(ok "set-cow" (and (= (set-size s) 1) (= (set-size t) 2) (set-member? t 2) (not (set-member? s 2))))
(ok "set-is-hash" (and (set? (set 1)) (set? (hash "a" 1))))
(ok "num" (and (= (+ 1 2) 3) (= (round 1.6) 2) (= (abs -3) 3)))
(define path (let ((p (getenv "IO_PATH"))) (if (string? p) p "out/v020/io.txt")))
(write-file path "ping")
(ok "io" (equal? (read-file path) "ping"))
(define j (json-parse "{\"n\":3,\"s\":\"x\"}"))
(ok "json" (and (= (hash-ref j "n") 3) (equal? (hash-ref j "s") "x")))
(define caught (try (error "boom") (catch (e) (format "~a" e))))
(ok "error" (> (string-length (format "~a" caught)) 0))
(display (format "@@error-text=~a" caught)) (newline)
(display "@@status=ok") (newline)
