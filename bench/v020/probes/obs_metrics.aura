(require "std/engine-metrics" all:)
(require "std/query" all:)
(define (say k v) (display (format "@@~a=~a" k v)) (newline))
(define m (engine-metrics:get))
(say "schema" (hash-ref m "schema" -1))
(say "stats-count" (hash-ref m "stats-count" -1))
(say "has-issue-key" (if (hash-has-key? m "issue-3531") 1 0))
(say "groups" (hash-keys m))
(define help (try (query:help "find") (catch (e) (format "ERR ~a" e))))
(say "query-help-string" (if (string? help) 1 0))
(say "query-help-len" (if (string? help) (string-length help) -1))
(define fb (try (stats:get "query:fiber-boundary-violation-stats") (catch (e) #f)))
(say "fiber-boundary-hash" (if (hash? fb) 1 0))
(define c0 (engine-metrics:group "compile"))
(say "compile-keys" (length (hash-keys c0)))
(define t0 (monotonic-ms))
(let loop ((i 0)) (if (< i 2000) (begin (engine:metrics) (loop (+ i 1))) i))
(define t1 (monotonic-ms))
(let loop ((i 0) (a 0)) (if (< i 2000) (loop (+ i 1) (+ a 1)) a))
(define t2 (monotonic-ms))
(let loop ((i 0)) (if (< i 2000) (begin (stats:get "compile:epoch") (loop (+ i 1))) i))
(define t3 (monotonic-ms))
(say "metrics-2000-ms" (- t1 t0))
(say "empty-2000-ms" (- t2 t1))
(say "stats-get-2000-ms" (- t3 t2))
(say "status" "ok")
