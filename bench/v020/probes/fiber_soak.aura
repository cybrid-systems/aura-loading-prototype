(define secs (string->number (getenv "SOAK_S")))
(define n (string->number (getenv "FIBER_N")))
(define (range n)
  (let loop ((i (- n 1)) (a (list)))
    (if (< i 0) a (loop (- i 1) (cons i a)))))
(define (once)
  (let ((fs (map (lambda (i)
                   (fiber:spawn (lambda ()
                     (let ((i i))
                       (fiber:overlay-begin)
                       (fiber:overlay-define "chosen-plan" i)
                       (fiber:overlay-rollback)
                       i))))
                 (range n))))
    (for-each fiber:join fs)))
(define t0 (monotonic-ms))
(define rounds 0)
(let loop ()
  (if (< (- (monotonic-ms) t0) (* secs 1000))
      (begin (once) (set! rounds (+ rounds 1)) (loop))
      rounds))
(display (format "@@rounds=~a" rounds)) (newline)
(display (format "@@elapsed_ms=~a" (- (monotonic-ms) t0))) (newline)
(display "@@status=ok") (newline)
