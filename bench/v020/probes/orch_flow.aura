(require "std/orch" all:)
(define (say k v) (display (format "@@~a=~a" k v)) (newline))
(orch:define-role "add1" (cons (lambda (x) (+ x 1)) "direct"))
(orch:define-role "add2" (cons (lambda (x) (+ x 2)) "direct"))
(say "pipeline" (orch:pipeline (list "add1" "add2") 0))
(define ntry 0)
(orch:define-role "flaky" (cons (lambda (x)
  (set! ntry (+ ntry 1))
  (if (< ntry 2) #f (+ x 1))) "direct"))
(say "retry" (orch:conduct (list (orch:retry "flaky" 5)) 10))
(say "retry-attempts" ntry)
(define pr (orch:parallel (list (lambda (x) (* x 2)) (lambda (x) (* x 3))) 5))
(say "parallel" pr)
(define bad 0)
(define sr (orch:supervise
  (list (lambda (x)
          (set! bad (+ bad 1))
          (if (< bad 2) (error "nope") (+ x 1))))
  10 2))
(say "supervise" sr)
(say "supervise-attempts" bad)
(say "status" "ok")
