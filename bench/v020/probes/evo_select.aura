(require "std/evo-core" all:)
(require "std/moead" all:)
(require "std/algo-select" all:)
(define (say k v) (display (format "@@~a=~a" k v)) (newline))
(define r1 (evo:rng 7 1 2))
(define a (evo:rng-int! r1 0 100000))
(define r2 (evo:rng 7 1 2))
(define b (evo:rng-int! r2 0 100000))
(say "rng-eq" (if (= a b) 1 0))
(say "rng" a)
(define c (evo:candidate (list 1 2 3) "id" "c0" "gen" 0))
(say "cand" (if (evo:candidate? c) 1 0))
(define ms (moead:make (hash "n-obj" 2 "H" 5 "T" 2 "dim" 3 "seed" 1 "dirs" (list "min" "min"))))
(define asked (try (moead:ask ms 2) (catch (e) (format "ERR ~a" e))))
(say "moead-ask" (if (pair? asked) (length asked) asked))
(define matrix (hash
  "members" (list "wall" "block")
  "instances" (list
    (hash "a" 1 "b" 2 "c" 3 "d" 4 "e" 5 "f" 6 "g" 7 "h" 8)
    (hash "a" 8 "b" 1 "c" 7 "d" 2 "e" 6 "f" 3 "g" 5 "h" 4)
    (hash "a" 3 "b" 9 "c" 1 "d" 8 "e" 2 "f" 4 "g" 6 "h" 5)
    (hash "a" 4 "b" 4 "c" 4 "d" 9 "e" 1 "f" 7 "g" 2 "h" 3))
  "means" (list (list 9.0 1.0) (list 4.0 3.0) (list 8.0 2.0) (list 5.0 2.5))))
(define sel (select:make (hash "model" "knn" "k" 2 "sense" "min")))
(define fitted (try (select:offline sel matrix (hash)) (catch (e) (format "ERR ~a" e))))
(say "select-offline" (if (hash? fitted) 1 0))
(define choice (if (hash? fitted)
                   (try (select:choose fitted (hash "a" 1 "b" 2 "c" 3 "d" 4 "e" 5 "f" 6 "g" 7 "h" 8) 1)
                        (catch (e) (format "ERR ~a" e)))
                   "skip"))
(say "select-choose" choice)
(say "status" "ok")
