(require "std/mutate" all:)
(define (say k v) (display (format "@@~a=~a" k v)) (newline))
(define (g h k) (hash-ref h k 0))
(define src
  (let loop ((i 0) (s ""))
    (if (= i 40) s
        (loop (+ i 1) (string-append s (format "(define (f~a x) (+ x ~a)) " i i))))))
(define t0 (monotonic-ms))
(define seed-ok (try (begin (set-code src) (eval-current) #t) (catch (e) (format "ERR ~a" e))))
(define t1 (monotonic-ms))
(say "seed" seed-ok)
(say "seed-ms" (- t1 t0))
(define e0 (engine:metrics :group "compile"))
(define t2 (monotonic-ms))
(define fails 0)
(let loop ((k 0))
  (if (< k 20)
      (begin
        (let ((ok (try (begin
                         (mutate:rebind "f0" (format "(lambda (x) (+ x ~a))" (+ 100 k)) "bench")
                         (eval-current)
                         #t)
                       (catch (e) #f))))
          (if (not ok) (set! fails (+ fails 1))))
        (loop (+ k 1)))
      #t))
(define t3 (monotonic-ms))
(define e1 (engine:metrics :group "compile"))
(say "rebind-fails" fails)
(say "rebind-ms" (- t3 t2))
(say "per-fn" (- (g e1 "relower_per_function_called_count") (g e0 "relower_per_function_called_count")))
(say "full-cnt" (- (g e1 "relower_full_called_count") (g e0 "relower_full_called_count")))
(say "invalidate-calls" (- (g e1 "invalidate_function_calls") (g e0 "invalidate_function_calls")))
(say "cascade-bfs" (- (g e1 "cascade_bfs_invalidate_total") (g e0 "cascade_bfs_invalidate_total")))
(say "funcs-saved" (- (g e1 "relower_partial_funcs_saved_total") (g e0 "relower_partial_funcs_saved_total")))
(say "f0" (try (f0 1) (catch (e) (format "ERR ~a" e))))
(define log (try (query :mutation-log) (catch (e) (format "ERR ~a" e))))
(say "mutation-log-type" (if (string? log) "err" "value"))
(say "mutation-log" log)
(say "status" "ok")
