;; Documented shared-global race (fiber-spawn.md): N fibers cons onto one list.
(define (range n)
  (let loop ((i (- n 1)) (a (list)))
    (if (< i 0) a (loop (- i 1) (cons i a)))))
(define log (list))
(define (worker id)
  (lambda ()
    (let loop ((i 0))
      (if (< i 20)
          (begin (set! log (cons id log)) (fiber:yield) (loop (+ i 1)))
          id))))
(define fs (map (lambda (id) (fiber:spawn (worker id))) (range 4)))
(for-each fiber:join fs)
(display (format "@@len=~a" (length log))) (newline)
(display "@@expect=80") (newline)
(display "@@status=ran") (newline)
