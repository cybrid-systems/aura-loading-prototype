;; Loading-prototype shape: N fibers, private overlay, coordinator commits one.
(define (range n)
  (let loop ((i (- n 1)) (a (list)))
    (if (< i 0) a (loop (- i 1) (cons i a)))))
(define (say k v) (display (format "@@~a=~a" k v)) (newline))
(define nagents 8)
(define rounds 40)
(define (once)
  (let* ((res (channel:create 16))
         (ver (map (lambda (i) (channel:create 1)) (range nagents)))
         (fs (map (lambda (i)
                    (let ((vch (list-ref ver i)))
                      (fiber:spawn (lambda ()
                        (let ((res res) (vch vch) (i i))
                          (fiber:overlay-begin)
                          (fiber:overlay-define "chosen-plan" i)
                          (channel:send res i)
                          (let ((v (channel:recv vch)))
                            (if (equal? v "commit") (fiber:overlay-commit) (fiber:overlay-rollback))
                            i))))))
                  (range nagents))))
    (let ((ids (map (lambda (f) (channel:recv res)) fs)))
      (for-each (lambda (id)
                  (channel:send (list-ref ver id) (if (= id 0) "commit" "rollback")))
                ids)
      (for-each fiber:join fs)
      (try chosen-plan (catch (e) -1)))))
(define t0 (monotonic-ms))
(define bad 0)
(let loop ((r 0))
  (if (< r rounds)
      (begin (if (not (= (once) 0)) (set! bad (+ bad 1))) (loop (+ r 1)))
      #t))
(define t1 (monotonic-ms))
(say "rounds" rounds)
(say "bad" bad)
(say "ms" (- t1 t0))
(say "status" "ok")
