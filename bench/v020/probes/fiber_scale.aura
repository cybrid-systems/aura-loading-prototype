(define n (string->number (getenv "FIBER_N")))
(define work (string->number (getenv "FIBER_WORK")))
(define (range n)
  (let loop ((i (- n 1)) (a (list)))
    (if (< i 0) a (loop (- i 1) (cons i a)))))
(define (spin)
  (let loop ((i 0) (a 0))
    (if (>= i work) a (loop (+ i 1) (+ a (modulo i 7))))))
(define t0 (monotonic-ms))
(define fs (map (lambda (i) (fiber:spawn (lambda () (spin)))) (range n)))
(define t1 (monotonic-ms))
(define s (foldl (lambda (a f) (+ a (fiber:join f))) 0 fs))
(define t2 (monotonic-ms))
(display (format "@@spawn_ms=~a" (- t1 t0))) (newline)
(display (format "@@join_ms=~a" (- t2 t1))) (newline)
(display (format "@@wall_ms=~a" (- t2 t0))) (newline)
(display (format "@@sum=~a" s)) (newline)
(display "@@status=ok") (newline)
