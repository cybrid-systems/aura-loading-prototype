;; Spawn identity, overlay isolation, cancel, exception, channel backpressure.
(define (range n)
  (let loop ((i (- n 1)) (a (list)))
    (if (< i 0) a (loop (- i 1) (cons i a)))))
(define (say k v) (display (format "@@~a=~a" k v)) (newline))
(say "backend" (fiber:spawn-backend))
(define f1 (fiber:spawn (lambda () 1)))
(define f2 (fiber:spawn (lambda () 2)))
(define j1 (fiber:join f1))
(define j2 (fiber:join f2))
(say "ids-distinct" (if (and (number? f1) (> f1 0) (> f2 0) (not (= f1 f2)) (= j1 1) (= j2 2)) 1 0))

(define res (channel:create 4))
(define ver (channel:create 4))
(define (worker label)
  (fiber:spawn (lambda ()
    (let ((res res) (ver ver) (label label))
      (fiber:overlay-begin)
      (fiber:overlay-define "chosen-plan" label)
      (channel:send res label)
      (let ((v (channel:recv ver)))
        (if (equal? v "commit") (fiber:overlay-commit) (fiber:overlay-rollback))
        v)))))
(define a (worker "A"))
(define b (worker "B"))
(define p1 (channel:recv res))
(define p2 (channel:recv res))
(define before (try chosen-plan (catch (e) "unbound")))
(channel:send ver (if (equal? p1 "A") "commit" "rollback"))
(channel:send ver (if (equal? p2 "A") "commit" "rollback"))
(fiber:join a)
(fiber:join b)
(define after (try chosen-plan (catch (e) "unbound")))
(say "overlay-before" before)
(say "overlay-after" after)
(say "overlay-ok" (if (and (equal? before "unbound") (equal? after "A")) 1 0))

(define cf (fiber:spawn (lambda ()
  (try (let loop ((i 0)) (fiber:yield) (loop (+ i 1)))
       (catch (e) (format "~a" e))))))
(define cancelled (fiber:cancel cf))
(define cj (fiber:join cf))
(say "cancel-accepted" (if cancelled 1 0))
(say "cancel-join" cj)

(define ef (fiber:spawn (lambda () (error "boom"))))
(say "exn-join" (try (fiber:join ef) (catch (e) (format "caught ~a" e))))

(define cap (channel:create 1))
(define done (channel:create 1))
(define sf (fiber:spawn (lambda ()
  (let ((cap cap) (done done))
    (channel:send cap 1)
    (channel:send cap 2)
    (channel:send cap 3)
    (channel:send done 1)))))
(define t0 (monotonic-ms))
(let loop () (if (< (- (monotonic-ms) t0) 200) (begin (fiber:yield) (loop))))
(define early (channel:try-recv done))
(say "bp-early" early)
;; drain so the sender can finish
(channel:recv cap) (channel:recv cap) (channel:recv cap)
(fiber:join sf)
(say "status" "ok")
