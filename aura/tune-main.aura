;; 入口：PC_TRAIN（训练柜单）PC_HOLDOUT（留出柜单，可选）PC_GENS（代数）PC_OUT
(define out-dir (env-or "PC_OUT" "out/tune"))
(sh (string-append "mkdir -p " out-dir))
(define (split-ws s)
  (let ((n (string-length s)))
    (let loop ((i 0) (start 0) (acc (list)))
      (cond ((= i n) (reverse (if (> i start) (cons (substring s start i) acc) acc)))
            ((char=? (string-ref s i) #\space) (loop (+ i 1) (+ i 1) (if (> i start) (cons (substring s start i) acc) acc)))
            (else (loop (+ i 1) start acc))))))
(define (split-lines s)
  (let ((n (string-length s)))
    (let loop ((i 0) (start 0) (acc (list)))
      (cond ((= i n) (reverse (if (> i start) (cons (substring s start i) acc) acc)))
            ((char=? (string-ref s i) #\newline) (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
            (else (loop (+ i 1) start acc))))))
(define start-strategies active-strategies)
(define result (tune (split-ws (getenv "PC_TRAIN")) (string->number (env-or "PC_GENS" "3")) (string-append out-dir "/tune-audit.tsv")))
(write-file (string-append out-dir "/tuned-strategies.txt") (format "~s" (cadr result)))
;; 留出集：初始 vs 演化后的人工经验构造器（训练时没见过）
(define holdout (split-ws (env-or "PC_HOLDOUT" "")))
(define (hold rs tag) (let ((pre (format "~a/hold-~a" out-dir tag))) (await-file (fill-launch (human-params rs) holdout pre)) (fill-result pre)))
(define hb (if (null? holdout) #f (hold start-strategies "before")))
(define ha (if (null? holdout) #f (hold (cadr result) "after")))
(write-file (string-append out-dir "/tune-summary.txt")
  (format "train_util_sum=~a\nholdout_before=~a\nholdout_after=~a\nparams_before=~a\nparams_after=~a\n"
          (r3 (car (car result))) (if hb (r3 (car hb)) "-") (if ha (r3 (car ha)) "-") (human-params start-strategies) (human-params (cadr result))))
(display "@@done=ok") (newline)
