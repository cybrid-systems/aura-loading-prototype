;; aura/rules.aura — 配仓规则 EDSL（规则即数据，运行时可替换，不改内核代码）
;;
;; 一条规则： (类别 名称 参数... "说明")
;;   hard   —— 下推给 C++ 内核作为硬约束（支撑率、先卸后装、危险品间距、柜型、限重、禁混装…）
;;   check  —— 方案出来后由 Aura 校验（重心范围、端部载荷、未装箱数、最低利用率…），不满足即否决
;;   prefer —— 软目标，进入协调器加权评分
;; 规则集是普通 list，可以在运行时 rebind / 从文件 load，再由 compile-rules 编译成内核参数 + 校验谓词。

(define default-rules
  '((hard  min-support   0.75  "货物底面至少 75% 有支撑")
    (hard  lifo          1     "先卸后装：先到站的货不能被后到站的货挡住")
    (hard  hazmat-sep    1000  "不同类别危险品纵向间距 ≥ 1000mm")
    (check cog-x         0.30 0.70 "重心纵向位置（占柜长比例）")
    (check cog-y         0.40 0.60 "重心横向位置（占柜宽比例）")
    (check max-unplaced  0     "所有货物必须装下")
    (check end-load      18000 "单端（前端/门端）分担载荷 ≤ 18000kg（两点支撑近似）")
    (prefer cost         1.0   "运费（相对柜价）")
    (prefer vol-util     0.3   "体积利用率")
    (prefer cog-dev      0.2   "重心偏离中心")))

(define (rule-kind r) (car r))
(define (rule-name r) (cadr r))
(define (rule-args r) (cddr r))
(define (rule-doc r) (let ((a (rule-args r))) (list-ref a (- (length a) 1))))
(define (rule-arg r i) (list-ref (rule-args r) i))
(define (rules-of kind rs) (filter (lambda (r) (eq? (rule-kind r) kind)) rs))
(define (find-rule rs kind name)
  (let loop ((xs rs)) (cond ((null? xs) #f)
                            ((and (eq? (rule-kind (car xs)) kind) (eq? (rule-name (car xs)) name)) (car xs))
                            (else (loop (cdr xs))))))
(define (rule-num rs kind name i dflt) (let ((r (find-rule rs kind name))) (if r (rule-arg r i) dflt)))
(define (sym->str x) (format "~a" x))
(define (but-last xs) (reverse (cdr (reverse xs))))
(define (push! xs x) (append xs (list x)))

;; hard / check -> 内核命令行参数。顺序固定，方便和 tools/ruleset.py 对拍。
;; only-type、allow-types、max-kg、no-mix 只在规则文件里出现时才传；不传则内核与改规则之前完全一样。
(define (rules->kernel-args rs)
  (let ((a (list))
        (ms (find-rule rs 'hard 'min-support))
        (lf (find-rule rs 'hard 'lifo))
        (hz (find-rule rs 'hard 'hazmat-sep))
        (ot (find-rule rs 'hard 'only-type))
        (at (find-rule rs 'hard 'allow-types))
        (mk (find-rule rs 'hard 'max-kg))
        (mix (filter (lambda (r) (eq? (rule-name r) 'no-mix)) (rules-of 'hard rs)))
        (cx (find-rule rs 'check 'cog-x))
        (cy (find-rule rs 'check 'cog-y)))
    (if ms (set! a (push! a (format "min_support=~a" (rule-arg ms 0)))) #f)
    (if lf (set! a (push! a (format "lifo=~a" (rule-arg lf 0)))) #f)
    (if hz (set! a (push! a (format "hazmat_sep=~a" (rule-arg hz 0)))) #f)
    (if ot (set! a (push! a (format "only=~a" (sym->str (rule-arg ot 0))))) #f)
    (if at (set! a (push! a (format "types=~a" (join-strings (map sym->str (but-last (rule-args at))) ",")))) #f)
    (if mk (set! a (push! a (format "cap_kg=~a" (rule-arg mk 0)))) #f)
    (if (null? mix) #f
        (set! a (push! a (format "no_mix=~a"
                                 (join-strings (map (lambda (r) (format "~a+~a" (sym->str (rule-arg r 0)) (sym->str (rule-arg r 1)))) mix) ",")))))
    (if cx (begin (set! a (push! a (format "cog_x_lo=~a" (rule-arg cx 0))))
                  (set! a (push! a (format "cog_x_hi=~a" (rule-arg cx 1))))) #f)
    (if cy (begin (set! a (push! a (format "cog_y_lo=~a" (rule-arg cy 0))))
                  (set! a (push! a (format "cog_y_hi=~a" (rule-arg cy 1))))) #f)
    (join-strings a " ")))

(define (join-strings xs sep)
  (if (null? xs) "" (foldl (lambda (acc x) (string-append acc sep x)) (car xs) (cdr xs))))

(define (hget h k d) (if (and (hash? h) (hash-has-key? h k)) (hash-ref h k) d))

;; check 规则 -> 对一个方案（json-parse 后的 hash）给出违例列表，空表 = 通过
(define (check-plan rs plan)
  (let ((m (hget plan "metrics" #f)) (cs (hget plan "containers" (list))) (bad (list)))
    (for-each
      (lambda (r)
        (let ((n (rule-name r)))
          (cond
            ((eq? n 'max-unplaced)
             (if (> (hget m "unplaced" 0) (rule-arg r 0)) (set! bad (cons (format "未装货物 ~a 件" (hget m "unplaced" 0)) bad)) #f))
            ((or (eq? n 'cog-x) (eq? n 'cog-y))
             (for-each (lambda (c)
                         (let ((v (list-ref (hget c "cog" (list 0.5 0.5 0)) (if (eq? n 'cog-x) 0 1))))
                           (if (or (< v (rule-arg r 0)) (> v (rule-arg r 1)))
                               (set! bad (cons (format "~a ~a=~a 超出 [~a,~a]" (hget c "type" "?") n (r3 v) (rule-arg r 0) (rule-arg r 1)) bad)) #f)))
                       cs))
            ((eq? n 'end-load)
             (for-each (lambda (c)
                         (let* ((e (hget c "end_load_kg" #f)) (f (hget e "front" 0)) (d (hget e "door" 0)))
                           (if (> (max f d) (rule-arg r 0))
                               (set! bad (cons (format "~a 端部载荷 ~akg > ~a" (hget c "type" "?") (round (max f d)) (rule-arg r 0)) bad)) #f)))
                       cs))
            ((eq? n 'min-vol-util)
             (if (< (hget m "vol_util" 0) (rule-arg r 0)) (set! bad (cons (format "体积利用率 ~a < ~a" (r3 (hget m "vol_util" 0)) (rule-arg r 0)) bad)) #f))
            ((eq? n 'only-type)
             (let ((want (sym->str (rule-arg r 0))))
               (for-each (lambda (c)
                           (if (equal? (hget c "type" "") want) #f
                               (set! bad (cons (format "规则 only-type：柜型 ~a 不在允许列表（只要 ~a）" (hget c "type" "?") want) bad))))
                         cs)))
            ((eq? n 'allow-types)
             (let ((ok (map sym->str (but-last (rule-args r)))))
               (for-each (lambda (c)
                           (if (str-in? (hget c "type" "") ok) #f
                               (set! bad (cons (format "规则 allow-types：柜型 ~a 不在允许列表" (hget c "type" "?")) bad))))
                         cs)))
            ((eq? n 'max-kg)
             (for-each (lambda (c)
                         (if (> (hget c "kg" 0) (rule-arg r 0))
                             (set! bad (cons (format "规则 max-kg：~a 毛重 ~akg > ~a" (hget c "type" "?") (round (hget c "kg" 0)) (rule-arg r 0)) bad))
                             #f))
                       cs))
            ((eq? n 'no-mix)
             (let ((a (sym->str (rule-arg r 0))) (b (sym->str (rule-arg r 1))))
               (for-each (lambda (c)
                           (let ((ks (box-classes c)))
                             (if (and (str-in? a ks) (str-in? b ks))
                                 (set! bad (cons (format "规则 no-mix：~a 同柜混装了 ~a 与 ~a" (hget c "type" "?") a b) bad))
                                 #f)))
                         cs)))
            (else #f))))
      (append (rules-of 'check rs) (rules-of 'hard rs)))
    (reverse bad)))

(define (r3 x) (/ (round (* x 1000.0)) 1000.0))
(define (absf x) (if (< x 0) (- 0 x) x))

(define (str-in? x xs)
  (let loop ((ys xs))
    (cond ((null? ys) #f)
          ((equal? x (car ys)) #t)
          (else (loop (cdr ys))))))

(define (sku-class s)
  (let ((n (string-length s)))
    (let loop ((i 0))
      (cond ((= i n) s)
            ((char=? (string-ref s i) #\-) (substring s 0 i))
            (else (loop (+ i 1)))))))

(define (box-classes c)
  (let ((acc (list)))
    (for-each (lambda (b)
                (let ((k (sku-class (hget b "sku" ""))))
                  (if (str-in? k acc) #f (set! acc (cons k acc)))))
              (hget c "boxes" (list)))
    acc))
