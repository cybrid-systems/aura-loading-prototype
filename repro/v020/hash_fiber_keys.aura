;; Distinct-key hash-set! from sibling CLI fibers. A lost key is a silent race.
(define (range n)
  (let loop ((i (- n 1)) (a (list)))
    (if (< i 0) a (loop (- i 1) (cons i a)))))
(define (trial n k)
  (let* ((h (hash))
         (fs (map (lambda (w)
                    (fiber:spawn (lambda ()
                      (let ((h h) (w w) (k k))
                        (let loop ((i 0))
                          (if (< i k)
                              (begin
                                (hash-set! h (format "~a-~a" w i) 1)
                                (loop (+ i 1)))
                              w))))))
                  (range n))))
    (for-each fiber:join fs)
    (hash-length h)))
(define n 8)
(define k 40)
(define expect (* n k))
(define worst expect)
(define bad 0)
(let loop ((t 0))
  (if (< t 30)
      (let ((got (trial n k)))
        (if (< got worst) (set! worst got))
        (if (< got expect) (set! bad (+ bad 1)))
        (loop (+ t 1)))
      #t))
(display (format "@@expect=~a" expect)) (newline)
(display (format "@@worst=~a" worst)) (newline)
(display (format "@@bad_trials=~a" bad)) (newline)
(display "@@status=ran") (newline)
